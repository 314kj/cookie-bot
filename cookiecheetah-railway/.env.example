# ===================================================================
# CookieCheetah Bot — Variables
# บน Railway: service บอท → Variables → Raw Editor → วางทั้งก้อนแล้วใส่ค่าหลัง =
# ID ทั้งหมด: Discord → User Settings → Advanced → เปิด Developer Mode → คลิกขวา → Copy ID
# ตัวที่ไม่ใช้ เว้นว่างไว้ได้
# ===================================================================

# ---------- จำเป็น ----------
# ตัวเดิมที่ตั้งไว้แล้ว ใช้ต่อได้
DISCORD_TOKEN=
# ตัวเดิมที่ตั้งไว้แล้ว ใช้ต่อได้ (ขอใหม่ที่ https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=
# ID เซิฟ Discord
GUILD_ID=
# role ที่ได้หลังอนุมัติ White List
ROLE_SURVIVOR=
# role ทีมที่ตอบ ticket / ส่งของ (หลายอันคั่นด้วย , เช่น 111,222)
ROLE_STAFF=
# ห้อง ticket ห้องเดียว — ทุก ticket จะเป็น thread ส่วนตัวในห้องนี้
TICKET_CHANNEL_ID=
# ห้องเก็บไฟล์บทสนทนาตอนปิด ticket
TRANSCRIPT_CHANNEL_ID=

# ---------- Donate (Stripe) — ไม่ใส่ STRIPE_SECRET_KEY = ปิดระบบ Donate ----------
# sk_test_... ตอนทดสอบ → เปลี่ยนเป็น sk_live_... ตอนใช้จริง
STRIPE_SECRET_KEY=
# ห้องแอดมินที่แจ้งว่าใครจ่ายแล้ว / ส่งของแล้ว (ว่าง = ไปห้อง mod-logs)
DONATE_LOG_CHANNEL_ID=
# ยอดขั้นต่ำต่อรอบ (Stripe รับขั้นต่ำ 10 บาท)
DONATE_MIN_BAHT=10
# จำนวนสูงสุดต่อรายการ
DONATE_MAX_QTY=99
# บิลหมดอายุกี่นาที (31–1440)
STRIPE_SESSION_MINUTES=60
STRIPE_CURRENCY=thb
# ว่าง = ใช้ตามที่เปิดใน Stripe Dashboard (แนะนำ) หรือใส่ promptpay,card
STRIPE_PAYMENT_METHODS=

# ---------- แนะนำ ----------
# role ที่ใช้ /panel /check /item และเห็นทุก ticket (คนมี Administrator ใช้ได้อยู่แล้ว)
ROLE_ADMIN=
# ห้อง 📜กฎ-ข้อต้องห้าม (ปุ่มในข้อความต้อนรับจะลิงก์ไปห้องนี้)
RULES_CHANNEL_ID=
# บันทึก อนุมัติ / ไม่ผ่าน / ถอด White List
WHITELIST_LOG_CHANNEL_ID=
# บันทึก เปิด/ปิด ticket, Steam ซ้ำ, ระบบมีปัญหา
MOD_LOG_CHANNEL_ID=
# ห้องวิธีเข้าเซิฟ (แนบลิงก์ใน DM ตอนอนุมัติ)
CONNECT_INFO_CHANNEL_ID=
# รหัสลับที่ซ่อนในห้องกฎ — บอทเช็คให้ว่าผู้เล่นตอบตรงไหม
SECRET_CODE=
# บอกผู้เล่นใน DM ตอนอนุมัติ
GAME_VERSION=Build 42.19.0

# ---------- ไม่บังคับ (มีค่าเริ่มต้นแล้ว) ----------
# ถ้าใส่: ได้ role นี้ทันทีที่ส่งคำขอ White List (ใช้เปิดห้องทั่วไปให้เห็นระหว่างรอ)
ROLE_MEMBER=
# true = ต้องกรอก Steam ที่มีอยู่จริงถึงจะส่งคำขอได้
STEAM_REQUIRED=true
# true = ต้องเห็นเกม Project Zomboid ในบัญชี Steam ถึงจะส่งได้
STEAM_REQUIRE_PZ=false
# สีแถบข้างข้อความต้อนรับ
ACCENT_COLOR=22C7E8
# ลิงก์รูปหัวข้อความต้อนรับ (หรือวางไฟล์ assets/banner.png ในโค้ดแทน)
WELCOME_BANNER_URL=
MAX_OPEN_PER_TYPE=1
ALLOW_OWNER_CLOSE=true
DM_TRANSCRIPT=false
PING_STAFF_ON_NEW=true
PASSWORD_LENGTH=8
SET_NICKNAME=true
AUTO_CLOSE_AFTER_DECISION=true
UTC_OFFSET=7

# RCON — บน Railway ปล่อยปิดไว้ (ต่อเข้าเครื่องในบ้านผ่าน Radmin ไม่ได้)
# ตอนอนุมัติบอทจะส่งคำสั่ง adduser ให้แอดมินก๊อปไปวางในคอนโซลเซิฟเอง
RCON_ENABLED=false
RCON_HOST=
RCON_PORT=27015
RCON_PASSWORD=
